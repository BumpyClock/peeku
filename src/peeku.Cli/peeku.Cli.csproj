<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\peeku.Core\peeku.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\\peeku.Daemon\\peeku.Daemon.csproj')">
    <ProjectReference Include="..\peeku.Daemon\peeku.Daemon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>peeku</AssemblyName>
    <TargetName>peeku</TargetName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\\peeku.Daemon\\peeku.Daemon.csproj')">
    <DefineConstants>$(DefineConstants);PEEKU_DAEMON</DefineConstants>
  </PropertyGroup>

</Project>
